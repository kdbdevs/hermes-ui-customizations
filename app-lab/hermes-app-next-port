#!/usr/bin/env bash
set -euo pipefail

REGISTRY="${HERMES_APP_LAB_REGISTRY:-/var/lib/hermes-apps/registry.json}"
python3 - "$REGISTRY" <<'PY'
import json
import socket
import sys

used = set()
try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
    for app in data.get("apps", {}).values():
        used.add(int(app.get("port")))
except Exception:
    pass

for port in range(3101, 4000):
    if port in used:
        continue
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", port))
    except OSError:
        continue
    finally:
        s.close()
    print(port)
    raise SystemExit(0)
raise SystemExit("No free App Lab port found")
PY
