[Unit]
Description=Hermes App Lab reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HERMES_APP_LAB_HOST=127.0.0.1
Environment=HERMES_APP_LAB_PORT=18080
Environment=HERMES_APP_LAB_REGISTRY=/var/lib/hermes-apps/registry.json
Environment=HERMES_APP_LAB_DOMAIN_ROOT=apps.cloudnes.space
Environment=HERMES_APP_LAB_PUBLIC_BASE=https://apps.cloudnes.space
ExecStart=/usr/local/bin/node /opt/hermes-app-lab/app_lab_proxy.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
