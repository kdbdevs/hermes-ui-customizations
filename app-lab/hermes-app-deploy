#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  hermes-app-deploy <app_dir> <slug> <port> <start_command> [title] [summary]

Registers and starts a fullstack app in Hermes App Lab.

Example:
  hermes-app-deploy /root/hermes-apps/shoe-crm shoe-crm 3101 "npm run start" "Shoe CRM" "Fullstack CRM demo"
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -lt 4 ]]; then
  usage
  exit 0
fi

APP_DIR="$1"
SLUG="$2"
PORT="$3"
START_COMMAND="$4"
TITLE="${5:-$SLUG}"
SUMMARY="${6:-Hermes fullstack app}"
ROOT="${HERMES_APP_LAB_ROOT:-/var/lib/hermes-apps}"
REGISTRY="$ROOT/registry.json"
DOMAIN_ROOT="${HERMES_APP_LAB_DOMAIN_ROOT:-apps.cloudnes.space}"

if [[ ! -d "$APP_DIR" ]]; then
  echo "App directory not found: $APP_DIR" >&2
  exit 1
fi

if [[ ! "$SLUG" =~ ^[a-z0-9][a-z0-9-]{1,50}$ ]]; then
  echo "Invalid slug. Use lowercase letters, numbers, and hyphens only." >&2
  exit 1
fi

if [[ ! "$PORT" =~ ^[0-9]+$ || "$PORT" -lt 3101 || "$PORT" -gt 3999 ]]; then
  echo "Port must be a number between 3101 and 3999." >&2
  exit 1
fi

mkdir -p "$ROOT"
if [[ ! -f "$REGISTRY" ]]; then
  printf '{"apps":{}}\n' > "$REGISTRY"
fi

SERVICE="/etc/systemd/system/hermes-app-${SLUG}.service"

python3 - "$SERVICE" "$APP_DIR" "$PORT" "$START_COMMAND" <<'PY'
import shlex
import sys

service, app_dir, port, command = sys.argv[1:5]
body = f"""[Unit]
Description=Hermes App Lab app: {app_dir}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={app_dir}
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT={port}
ExecStart=/bin/bash -lc {shlex.quote(command)}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
"""
with open(service, "w", encoding="utf-8") as f:
    f.write(body)
PY

python3 - "$REGISTRY" "$SLUG" "$APP_DIR" "$PORT" "$TITLE" "$SUMMARY" "$START_COMMAND" <<'PY'
import datetime as dt
import json
import os
import sys

registry_path, slug, app_dir, port, title, summary, command = sys.argv[1:8]
try:
    with open(registry_path, encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    data = {"apps": {}}
data.setdefault("apps", {})[slug] = {
    "title": title,
    "summary": summary,
    "path": os.path.abspath(app_dir),
    "host": "127.0.0.1",
    "port": int(port),
    "start_command": command,
    "updated_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
}
tmp = registry_path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
os.replace(tmp, registry_path)
PY

systemctl daemon-reload
systemctl enable --now "hermes-app-${SLUG}.service"
systemctl restart "hermes-app-${SLUG}.service"
sleep 2

echo "Service: hermes-app-${SLUG}.service"
echo "Local:   http://127.0.0.1:${PORT}/"
echo "Public:  https://${SLUG}.${DOMAIN_ROOT}/"
