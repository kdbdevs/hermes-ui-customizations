#!/usr/bin/env bash
set -euo pipefail

REGISTRY="${HERMES_APP_LAB_REGISTRY:-/var/lib/hermes-apps/registry.json}"
python3 - "$REGISTRY" <<'PY'
import json
import sys

try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    data = {"apps": {}}

apps = data.get("apps", {})
if not apps:
    print("No Hermes App Lab apps registered.")
    raise SystemExit(0)

for slug, app in sorted(apps.items()):
    print(f"{slug:24} port={app.get('port')} url=https://{slug}.apps.cloudnes.space/ path={app.get('path')}")
PY
